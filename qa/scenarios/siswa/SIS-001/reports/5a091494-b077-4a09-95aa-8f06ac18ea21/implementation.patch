+import { randomUUID } from 'node:crypto';
+import { afterAll, afterEach, describe, expect, it, vi } from 'vitest';
+import { eq, inArray, isNull, sql } from 'drizzle-orm';
+import {
+  analyticsEvents,
+  analyticsOutbox,
+  closeDatabaseConnection,
+  getDatabase,
+} from '@tka/database';
+import { drainOutboxBatch, outboxStatus } from './outbox.js';
+
+const integration = process.env.TEST_DATABASE_URL ? describe : describe.skip;
+integration('atomic outbox groups and poison-event fallback', () => {
+  afterAll(closeDatabaseConnection);
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    const { db } = getDatabase();
+    await db
+      .update(analyticsOutbox)
+      .set({ failedAt: null })
+      .where(isNull(analyticsOutbox.processedAt));
+    await drainOutboxBatch(1000);
+  });
+  async function events(count: number) {
+    const rows = Array.from({ length: count }, (_, index) => ({
+      id: randomUUID(),
+      eventName: 'drill_completed',
+      eventVersion: '2',
+      entityType: 'assessmentAttempt',
+      entityId: randomUUID(),
+      correlationId: randomUUID(),
+      occurredAt: new Date(Date.UTC(2020, 0, 1, 0, 0, index)),
+      payload: { fixture: true, index, text: '∑ siswa 😊', optional: null },
+    }));
+    await getDatabase().db.insert(analyticsOutbox).values(rows);
+    return rows;
+  }
+  it('rejects invalid limits and reports an empty queue without work', async () => {
+    for (const limit of [0, -1, 1.5, 1001, NaN])
+      await expect(drainOutboxBatch(limit)).rejects.toThrow('OUTBOX_LIMIT_INVALID');
+    expect(await drainOutboxBatch()).toEqual({ processed: 0, failed: 0 });
+  });
+  it('respects the public limit and preserves full event contents with bounded SQL work', async () => {
+    const rows = await events(27);
+    const spy = vi.spyOn(getDatabase().client, 'unsafe');
+    expect(await drainOutboxBatch(25)).toEqual({ processed: 25, failed: 0 });
+    expect(spy.mock.calls.length).toBe(3);
+    spy.mockRestore();
+    const delivered = await getDatabase()
+      .db.select()
+      .from(analyticsEvents)
+      .where(
+        inArray(
+          analyticsEvents.eventId,
+          rows.map((r) => r.id),
+        ),
+      );
+    expect(delivered).toHaveLength(25);
+    for (const [index, event] of rows.entries()) {
+      const stored = delivered.find((r) => r.eventId === event.id);
+      if (index >= 25) expect(stored).toBeUndefined();
+      else
+        expect(stored).toMatchObject({
+          eventId: event.id,
+          eventName: event.eventName,
+          eventVersion: '2',
+          actorUserId: null,
+          entityType: event.entityType,
+          entityId: event.entityId,
+          correlationId: event.correlationId,
+          occurredAt: event.occurredAt,
+          payload: event.payload,
+        });
+    }
+  });
+  it('acknowledges partial and complete redelivery without rewriting existing analytics', async () => {
+    const rows = await events(4);
+    await getDatabase()
+      .db.insert(analyticsEvents)
+      .values(
+        rows
+          .slice(0, 2)
+          .map(({ id, ...event }) => ({ ...event, eventId: id, payload: { historical: true } })),
+      );
+    expect(await drainOutboxBatch(4)).toEqual({ processed: 4, failed: 0 });
+    const delivered = await getDatabase()
+      .db.select()
+      .from(analyticsEvents)
+      .where(
+        inArray(
+          analyticsEvents.eventId,
+          rows.map((r) => r.id),
+        ),
+      );
+    expect(delivered).toHaveLength(4);
+    expect(delivered.find((r) => r.eventId === rows[0]!.id)?.payload).toEqual({ historical: true });
+    await getDatabase()
+      .db.update(analyticsOutbox)
+      .set({ processedAt: null })
+      .where(
+        inArray(
+          analyticsOutbox.id,
+          rows.map((r) => r.id),
+        ),
+      );
+    expect(await drainOutboxBatch(4)).toEqual({ processed: 4, failed: 0 });
+    expect(
+      await getDatabase()
+        .db.select()
+        .from(analyticsEvents)
+        .where(
+          inArray(
+            analyticsEvents.eventId,
+            rows.map((r) => r.id),
+          ),
+        ),
+    ).toHaveLength(4);
+  });
+  for (const failure of ['insert', 'acknowledgment'] as const) {
+    it(`rolls back a failed group and isolates ${failure} failure without counting it twice`, async () => {
+      const rows = await events(4),
+        bad = rows[1]!;
+      const { db } = getDatabase();
+      const name = 'test_batch_' + randomUUID().replaceAll('-', '');
+      const table = failure === 'insert' ? 'analytics_events' : 'analytics_outbox';
+      const condition =
+        failure === 'insert'
+          ? `NEW.event_id='${bad.id}'::uuid`
+          : `NEW.id='${bad.id}'::uuid and NEW.processed_at is not null`;
+      await db.execute(
+        sql.raw(
+          `create function ${name}() returns trigger language plpgsql as $$ begin if ${condition} then raise exception 'TEST ONLY batch delivery failure'; end if; return NEW; end $$`,
+        ),
+      );
+      await db.execute(
+        sql.raw(
+          `create trigger ${name} before ${failure === 'insert' ? 'insert' : 'update'} on ${table} for each row execute function ${name}()`,
+        ),
+      );
+      try {
+        expect(await drainOutboxBatch(4)).toEqual({ processed: 3, failed: 1 });
+        expect(
+          await db.select().from(analyticsEvents).where(eq(analyticsEvents.eventId, bad.id)),
+        ).toHaveLength(0);
+        expect(
+          await db
+            .select()
+            .from(analyticsEvents)
+            .where(
+              inArray(
+                analyticsEvents.eventId,
+                rows.map((r) => r.id),
+              ),
+            ),
+        ).toHaveLength(3);
+        expect(await outboxStatus()).toMatchObject({
+          pending: 1,
+          failed: 1,
+          retryReady: 0,
+          coolingDown: 1,
+        });
+        expect(await drainOutboxBatch(10)).toEqual({ processed: 0, failed: 0 });
+      } finally {
+        await db.execute(sql.raw(`drop trigger ${name} on ${table}`));
+        await db.execute(sql.raw(`drop function ${name}()`));
+      }
+    });
+  }
+  it('lets two consumers acknowledge disjoint groups exactly once', async () => {
+    const rows = await events(20);
+    const results = await Promise.all([drainOutboxBatch(10), drainOutboxBatch(10)]);
+    expect(results.reduce((n, r) => n + r.processed, 0)).toBe(20);
+    expect(results.reduce((n, r) => n + r.failed, 0)).toBe(0);
+    const delivered = await getDatabase()
+      .db.select()
+      .from(analyticsEvents)
+      .where(
+        inArray(
+          analyticsEvents.eventId,
+          rows.map((r) => r.id),
+        ),
+      );
+    expect(new Set(delivered.map((r) => r.eventId)).size).toBe(20);
+    expect((await outboxStatus()).pending).toBe(0);
+  });
+});
diff --git a/scripts/qa/volume-flow.mjs b/scripts/qa/volume-flow.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/qa/volume-flow.mjs
@@ -0,0 +1,102 @@
+// Cumulative stages share one queue. A failed stage must never receive more load.
+export async function runVolumeStages(sizes, execute) {
+  if (
+    !Array.isArray(sizes) ||
+    sizes.length === 0 ||
+    sizes.some((n, i) => !Number.isSafeInteger(n) || n < 1 || (i > 0 && n <= sizes[i - 1]))
+  )
+    throw new Error('INVALID_VOLUME_STAGES');
+  const checks = [];
+  let stopped;
+  for (const count of sizes) {
+    const name = `volume-${count}-event-identity-and-payload`;
+    if (stopped) {
+      checks.push({
+        name,
+        count,
+        status: 'NOT_RUN',
+        reason: `PREVIOUS_STAGE_${stopped.status}: ${stopped.name}`,
+      });
+      continue;
+    }
+    const outcome = await execute({ count, name });
+    if (!outcome || !['PASS', 'FAIL', 'BLOCKED'].includes(outcome.status))
+      throw new Error('INVALID_VOLUME_STAGE_OUTCOME');
+    const check = { name, count, status: outcome.status };
+    if (outcome.reason) check.reason = outcome.reason;
+    checks.push(check);
+    if (check.status !== 'PASS') stopped = check;
+  }
+  return checks;
+}
+
+export function summarizeChecks(checks) {
+  if (!Array.isArray(checks) || checks.length === 0) throw new Error('EMPTY_CHECKS');
+  const result = { passed: 0, failed: 0, blocked: 0, skipped: 0, total: checks.length };
+  const field = { PASS: 'passed', FAIL: 'failed', BLOCKED: 'blocked', NOT_RUN: 'skipped' };
+  for (const check of checks) {
+    if (!Object.hasOwn(field, check.status)) throw new Error('UNKNOWN_CHECK_STATUS');
+    result[field[check.status]]++;
+  }
+  return result;
+}
+
+// EXISTS controls the loop; full counts/age remain required periodic/final evidence.
+// The deadline is cooperative: an in-flight SQL query/batch is not forcibly cancelled.
+export async function drainVolumeQueue({
+  budgetMs,
+  pending,
+  drainBatch,
+  snapshot,
+  onSnapshot = () => {},
+  sampleIntervalMs = 1000,
+  clock = () => performance.now(),
+}) {
+  if (
+    !Number.isFinite(budgetMs) ||
+    budgetMs <= 0 ||
+    !Number.isFinite(sampleIntervalMs) ||
+    sampleIntervalMs <= 0
+  )
+    throw new Error('INVALID_VOLUME_DRAIN_BOUND');
+  const start = clock();
+  let lastSample = start;
+  let batches = 0;
+  async function record(final) {
+    const state = await snapshot();
+    if (
+      !state ||
+      !Number.isSafeInteger(state.total) ||
+      !Number.isSafeInteger(state.pending) ||
+      state.pending < 0 ||
+      state.total < state.pending ||
+      !Number.isFinite(state.oldest_seconds) ||
+      state.oldest_seconds < 0
+    )
+      throw new Error('INVALID_VOLUME_SNAPSHOT');
+    await onSnapshot({ ...state, elapsedMs: clock() - start, batches, final });
+    return state;
+  }
+  await record(false);
+  while (clock() - start < budgetMs) {
+    const hasPending = await pending();
+    if (typeof hasPending !== 'boolean') throw new Error('INVALID_VOLUME_PENDING_PROBE');
+    if (!hasPending || clock() - start >= budgetMs) break;
+    await drainBatch(10);
+    batches++;
+    if (clock() - lastSample >= sampleIntervalMs) {
+      await record(false);
+      lastSample = clock();
+    }
+  }
+  const remaining = await record(true);
+  const elapsedMs = clock() - start;
+  if (remaining.pending > 0 || elapsedMs > budgetMs)
+    throw Object.assign(
+      new Error(
+        'Volume drain budget exhausted or backlog remains; capacity conclusion remains incomplete',
+      ),
+      { code: 'EXPERIMENT_INCOMPLETE', remaining, elapsedMs },
+    );
+  return { ...remaining, batches, elapsedMs: clock() - start };
+}
