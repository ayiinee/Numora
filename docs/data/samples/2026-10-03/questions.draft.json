  {
    "externalId": "CURR-IND20-L01-Q07",
    "type": "MULTIPLE_CHOICE_MULTIPLE_ANSWER",
    "chapterCode": "CH-DP",
    "subchapterCode": "SC-DATA",
    "competencyCode": "IND-020",
    "levelCode": null,
    "difficulty": null,
    "stem": {
      "text": "Perhatikan data pilihan ekstrakurikuler 50 siswa berikut.\n\nEkstrakurikuler — Jumlah Siswa\nBasket — 15\nFutsal — 20\nPramuka — 10\nPMR — 5\n\nPilihlah semua pernyataan yang benar!",
      "assetKeys": []
    },
    "options": [
      {
        "id": "A",
        "content": {
          "text": "Futsal memiliki jumlah peminat terbanyak.",
          "assetKeys": []
        }
      },
      {
        "id": "B",
        "content": {
          "text": "Jumlah peminat basket dan PMR adalah 20 siswa.",
          "assetKeys": []
        }
      },
      {
        "id": "C",
        "content": {
          "text": "Peminat Pramuka dua kali peminat PMR.",
          "assetKeys": []
        }
      },
      {
        "id": "D",
        "content": {
          "text": "Peminat PMR sama dengan peminat Basket.",
          "assetKeys": []
        }
      }
    ],
    "answer": {
      "optionIds": ["A", "B", "C"]
    },
    "explanation": {
      "text": "Futsal = 20 → terbanyak.\nBasket + PMR = 15 + 5 = 20.\nPramuka = 10, PMR = 5 → dua kali.\nPMR ≠ Basket.\nJadi pernyataan benar adalah 1, 2, dan 3.",
      "assetKeys": []
    },
    "metadata": {
      "source": "CURRICULUM_SHEETS_SAMPLE",
      "sourceSpreadsheetId": "1zU6OeahFcDWhF6Eq5HNy2LsSFi5yPVahr7QnZbKn0nw",
