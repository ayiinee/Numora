# Copy to .env.staging.local and fill with your staging secret manager.
NODE_ENV=production
APP_TIMEZONE=Asia/Jakarta
STAGING_WEB_ORIGIN=https://staging.example.test
STAGING_API_ORIGIN=https://api-staging.example.test
NEXT_PUBLIC_API_URL=https://api-staging.example.test/api/v1
API_INTERNAL_URL=https://api-staging.example.test/api/v1
CORS_ORIGINS=https://staging.example.test
ADMIN_AUTH_REDIRECT_ORIGIN=https://staging.example.test
API_PORT=3001

SUPABASE_PROJECT_REF=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Keep the migration URL on the migration operator and evidence URL on the QA generator.
DATABASE_URL=
DATABASE_MIGRATION_URL=
QA_CAPACITY_EVIDENCE_URL=
DB_POOL_MAX=3

STAGING_REDIS_HOST=
REDIS_URL=
BULLMQ_PREFIX=numora:staging:capacity

STAGING_R2_BUCKET=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_UPLOADS_ENABLED=true
TEACHER_TOKEN_PEPPER=
METRICS_TOKEN=
NUMORA_OBSERVABILITY_ENABLED=true
ALLOW_SYNTHETIC_CONTENT=false
ADMIN_ACCOUNT_INVITES_ENABLED=true
PVP_MODE=official
PVP_CONTENT_MODE=strict
PVP_NEW_MATCHES_ENABLED=true
