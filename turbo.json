{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "TEST_DATABASE_URL",
        "TEST_DATABASE_TLS_URL",
        "TEST_DATABASE_TLS_CA_FILE",
        "TEST_PSQL_PATH",
        "NODE_EXTRA_CA_CERTS",
        "NUMORA_BACKUP_PG_BIN",
        "TEST_REDIS_URL",
        "BULLMQ_PREFIX",
        "TEACHER_TOKEN_PEPPER"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
