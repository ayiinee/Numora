{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numora.local/contracts/pvp-events.schema.json",
  "title": "PvP WebSocket envelopes (/pvp namespace)",
  "$defs": {
    "PvpSnapshotDto": {
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string"
        },
        "roomCode": {
          "type": "string"
        },
        "creatorStudentId": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "WAITING",
            "READY",
            "RUNNING",
            "FINISHED",
            "CANCELLED"
          ]
        },
        "serverTime": {
          "type": "string"
        },
        "isDemo": {
          "type": "boolean"
        },
        "participantActive": {
          "type": "boolean"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordEligible": {
          "type": "boolean"
        },
        "endReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PvpPlayerDto"
          }
        },
        "question": {
          "anyOf": [
            {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/$defs/PvpQuestionDto"
                }
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "matchId",
        "roomCode",
        "creatorStudentId",
        "difficulty",
        "status",
        "serverTime",
        "isDemo",
        "recordEligible",
        "endReason",
        "players",
        "question"
      ],
      "additionalProperties": false
    },
    "PvpPlayerDto": {
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "slot": {
          "type": "number"
        },
        "ready": {
          "type": "boolean"
        },
        "connectionStatus": {
          "type": "string"
        },
        "reconnectDeadlineAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "type": "number"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "studentId",
        "displayName",
        "slot",
        "ready",
        "connectionStatus",
        "reconnectDeadlineAt",
        "points",
        "result"
      ],
      "additionalProperties": false
    },
    "StudentPeerDto": {
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "studentId",
        "displayName"
      ],
      "additionalProperties": false
    },
    "PvpQuestionDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "stem": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionDto"
          }
        },
        "deadlineAt": {
          "type": "string"
        },
        "durationSeconds": {
          "type": "number"
        },
        "answered": {
          "type": "boolean"
        },
        "selectedOptionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "order",
        "stem",
        "options",
        "deadlineAt",
        "durationSeconds",
        "answered",
        "selectedOptionId"
      ],
      "additionalProperties": false
    },
    "OptionDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer"
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "code",
        "detail"
      ]
    },
    "Acknowledgement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "state": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PvpSnapshotDto"
                },
                {
                  "type": "null"
                }
              ]
            },
            "response": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "inviteId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "inviteId"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ok",
            "state",
            "response"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/Problem"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    }
  },
  "oneOf": [
