{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:numora:irt-calibration-v1:common",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "points": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "maxLength": 18
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "approvalId"],
      "properties": {
        "id": {
          "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "urn:numora:irt-calibration-v1:common#/$defs/digest"
        },
        "approvalId": {
          "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
        }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "packageVersion"],
      "properties": {
        "packageId": {
          "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
        },
        "packageVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "revision",
        "scope",
        "scaleId",
        "chapterId",
        "indicatorId",
        "levelId",
        "batchId"
      ],
      "properties": {
        "contextId": {
          "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "enum": ["LEVEL", "TRYOUT_BATCH"]
        },
        "scaleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "chapterId": {
          "anyOf": [
            {
              "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicatorId": {
          "anyOf": [
            {
              "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "levelId": {
          "anyOf": [
            {
              "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "batchId": {
          "anyOf": [
            {
              "$ref": "urn:numora:irt-calibration-v1:common#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "measurementState": {
      "enum": ["CALIBRATED", "INSUFFICIENT", "NOT_COMPARABLE", "ANOMALY"]
    },
    "reasons": {
      "type": "array",
      "minItems": 0,
      "items": {
        "enum": [
          "INSUFFICIENT_SAMPLE",
          "LOW_PRECISION",
          "LINKING_FAILED",
          "ANCHOR_UNSTABLE",
          "MODEL_FIT_FAILED",
          "MODEL_CONVERGENCE_FAILED",
          "CONTENT_INVALID",
          "NO_VALID_ITEMS",
          "MAPPING_NOT_APPROVED",
          "RESPONDENT_PRECISION_INSUFFICIENT",
          "NO_ELIGIBLE_RESPONSES",
          "DIF_DETECTED",
          "LOCAL_DEPENDENCE",
          "UNSUPPORTED_DIMENSION",
          "MATERIAL_DRIFT"
        ]
      },
      "uniqueItems": true
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "level", "lower", "upper"],
      "properties": {
        "method": {
          "enum": ["DELTA_METHOD", "BOOTSTRAP", "PROFILE_LIKELIHOOD", "POSTERIOR"]
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "checks"],
      "properties": {
        "gate": {
          "enum": ["PASSED", "FAILED", "NOT_EVALUATED"]
        },
        "checks": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status", "statistic", "standardError"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "status": {
                "enum": ["PASS", "FAIL", "NOT_EVALUATED"]
              },
              "statistic": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "standardError": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
