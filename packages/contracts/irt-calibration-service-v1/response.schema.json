{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:numora:irt-calibration-service-v1:response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "serviceContract": {
      "const": "irt-calibration-service-v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dispatchGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "executionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "failureCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "serviceContract",
    "requestId",
    "inputDigest",
    "dispatchGeneration",
    "executionId",
    "status",
    "failureCode",
    "artifactId",
    "artifactDigest"
  ]
}
