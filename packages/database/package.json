{
  "name": "@tka/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:upgrade-check": "tsx src/upgrade-check.ts",
    "db:cloud:check": "tsx src/cloud-check.ts",
    "db:check": "tsx src/schema-check.ts",
    "db:staging:check": "tsx src/staging-bridge.ts check",
    "db:staging:apply": "tsx src/staging-bridge.ts apply",
    "db:staging:bridge-check": "tsx src/staging-bridge-check.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:learning": "tsx src/seed.ts --learning-only",
    "db:seed:qa": "tsx src/qa-seed.ts",
    "db:seed:redesign": "tsx src/redesign-seed.ts",
    "db:seed:lifecycle": "tsx src/seed-lifecycle-demo.ts",
    "db:seed:pvp": "tsx src/seed-pvp-demo.ts",
    "db:seed:assessments:mock": "tsx src/seed-assessment-mocks.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
