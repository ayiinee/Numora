# Use an isolated restored copy of Staging for read-only checks and migration rehearsal.
# Never commit .env.cloud.local or use the live Staging URL for migration rehearsal.
SUPABASE_PROJECT_REF=your_copy_project_ref
DATABASE_MIGRATION_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your_copy_project_ref.supabase.co:5432/postgres?sslmode=require

# JOB-10 foundation: explicit opt-in; never publishes student results.
IRT_V3_ENABLED=false
IRT_PSEUDONYM_KEY_VERSION=
