# Server-only example. Copy outside the checkout; replace placeholders privately.
# The API reads this environment from its process manager. Never load the Development .env.
NODE_ENV=production
NUMORA_DEPLOYMENT_PROFILE=production-vps
DATABASE_EXPECTED_HOST=db.numora.internal
DATABASE_EXPECTED_PORT=5432
DATABASE_EXPECTED_NAME=numora_production
DATABASE_EXPECTED_USER=numora_api
DATABASE_URL=postgresql://numora_api:REPLACE_URL_ENCODED_PASSWORD@db.numora.internal:5432/numora_production?sslmode=verify-full
# Example only, not a capacity recommendation. Budget all API/worker/IRT process pools together.
DB_POOL_MAX=3
# For a private CA: configure this before launching Node; certificate must cover the DB hostname.
# NODE_EXTRA_CA_CERTS=/etc/numora/certs/postgres-ca.crt

API_PORT=3001
CORS_ORIGINS=https://REPLACE_APP_DOMAIN
SUPABASE_URL=https://REPLACE_PRODUCTION_AUTH_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_OR_ANON_KEY
# Preserve the exact existing Production value so outstanding teacher-token hashes remain valid.
TEACHER_TOKEN_PEPPER=REPLACE_WITH_EXISTING_PRODUCTION_VALUE

REDIS_URL=rediss://default:REPLACE_URL_ENCODED_PASSWORD@REPLACE_REDIS_HOST:6379
BULLMQ_PREFIX=numora:prod:biznet
ALLOW_SYNTHETIC_CONTENT=false
PVP_MODE=disabled
PVP_CONTENT_MODE=strict
# Set official only after the current content/policy readiness gates pass. Do not relabel demo data.
NUMORA_OBSERVABILITY_ENABLED=false
# METRICS_TOKEN=REPLACE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# DATABASE_MIGRATION_URL belongs only to the designated migration runner, never this runtime file.
# Keep existing feature/IRT/R2 secrets and flags according to their own runbooks.
# NUMORA_IRT_DATABASE_URL, if used here, must target the same host/port/database with verify-full.
# Firebase migration, backup/bootstrap and data cutover are separate work.
