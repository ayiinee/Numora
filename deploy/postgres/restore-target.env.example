# Inject privately; this file never authorizes execution against an existing application database.
# Target is direct PostgreSQL on the operator's own VPS/isolated test host, via a loopback TLS DNS name.
NUMORA_BACKUP_TARGET_HOST=db.numora.internal
NUMORA_BACKUP_TARGET_PORT=5432
NUMORA_BACKUP_TARGET_DATABASE=numora_production
NUMORA_BACKUP_TARGET_USER=numora_migrator
NUMORA_BACKUP_TARGET_URL=postgresql://numora_migrator:REPLACE_URL_ENCODED_PASSWORD@db.numora.internal:5432/numora_production?sslmode=verify-full
# Existing PR 3 utility/CA settings apply; tools/server/archive must all be major 16 for this profile.
NUMORA_BACKUP_PG_BIN=/usr/lib/postgresql/16/bin
NUMORA_BACKUP_CA_FILE=/etc/numora/certs/postgres-ca.crt
NODE_EXTRA_CA_CERTS=/etc/numora/certs/postgres-ca.crt
# No application/runtime DATABASE_URL, migration URL or secrets are loaded automatically.
