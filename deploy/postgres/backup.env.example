# Server/operator only. Inject before Node starts; never use application .env as backup credentials.
# No credentials in command arguments or logs. Keep the actual file outside Git, mode 0600.
NUMORA_BACKUP_SOURCE_HOST=db.REPLACE_SOURCE_REF.supabase.co
NUMORA_BACKUP_SOURCE_PORT=5432
NUMORA_BACKUP_SOURCE_DATABASE=postgres
NUMORA_BACKUP_SOURCE_USER=REPLACE_APPROVED_BACKUP_LOGIN
NUMORA_BACKUP_SOURCE_URL=postgresql://REPLACE_APPROVED_BACKUP_LOGIN:REPLACE_URL_ENCODED_PASSWORD@db.REPLACE_SOURCE_REF.supabase.co:5432/postgres?sslmode=verify-full
# Absolute directory with same-major pg_dump and pg_restore; omit to use reviewed PATH.
# NUMORA_BACKUP_PG_BIN=/usr/lib/postgresql/16/bin
# Private/custom CA: both libpq and Node must trust it. Inject before launching Node.
# NUMORA_BACKUP_CA_FILE=/etc/numora/certs/source-ca.crt
# NODE_EXTRA_CA_CERTS=/etc/numora/certs/source-ca.crt

# Only for a separate, empty local original-owner rehearsal, never the Production target.
# NUMORA_BACKUP_REHEARSAL_HOST=localhost
# NUMORA_BACKUP_REHEARSAL_PORT=55432
# NUMORA_BACKUP_REHEARSAL_DATABASE=numora_restore_test_REPLACE_32_LOWERCASE_HEX
# NUMORA_BACKUP_REHEARSAL_USER=REPLACE_LOCAL_REHEARSAL_ADMIN
# NUMORA_BACKUP_REHEARSAL_URL=postgresql://REPLACE_LOCAL_REHEARSAL_ADMIN:REPLACE_PASSWORD@localhost:55432/numora_restore_test_REPLACE_32_LOWERCASE_HEX?sslmode=verify-full
