# PostgreSQL 16 / Ubuntu 22.04, co-located API + database. PROPOSED starting values;
# validate source major version, inventory and load before accepting capacity.
# Install as /etc/postgresql/16/main/conf.d/numora.conf on a NEW reviewed cluster only.
listen_addresses = 'localhost'
port = 5432
max_connections = 60
superuser_reserved_connections = 3
password_encryption = 'scram-sha-256'
ssl = on
ssl_min_protocol_version = 'TLSv1.2'
ssl_cert_file = '/etc/numora/postgres/server.crt'
ssl_key_file = '/etc/numora/postgres/server.key'
shared_buffers = '1GB'
effective_cache_size = '3GB'
work_mem = '4MB'
maintenance_work_mem = '128MB'
autovacuum_work_mem = '128MB'
autovacuum_max_workers = 3
max_parallel_workers_per_gather = 1
timezone = 'UTC'
log_timezone = 'UTC'
# Keep durable commits/recovery; never trade history/XP safety for benchmark speed.
fsync = on
full_page_writes = on
synchronous_commit = on
autovacuum = on
min_wal_size = '256MB'
max_wal_size = '1GB'
# SQL/parameters may contain student data or credentials. Application metrics carry timings.
log_statement = 'none'
log_min_duration_statement = -1
log_min_error_statement = 'panic'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_error_verbosity = 'terse'
log_line_prefix = '%m [%p] %u@%d '
