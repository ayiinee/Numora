# Dedicated operator only; inject before Node starts. Private file outside Git, mode 0600.
# Example S3-compatible endpoint; storage provider, independent failure domain and private bucket require review.
RESTIC_REPOSITORY=s3:https://REPLACE_STORAGE_HOST/REPLACE_BUCKET/numora-production
NUMORA_OFFHOST_EXPECTED_ORIGIN=https://REPLACE_STORAGE_HOST
NUMORA_OFFHOST_EXPECTED_PATH=/REPLACE_BUCKET/numora-production
# Full repository config ID after separately reviewed initialization. Never use a short prefix/latest.
NUMORA_OFFHOST_REPOSITORY_ID=REPLACE_64_LOWERCASE_HEX
NUMORA_OFFHOST_RESTIC=/usr/local/bin/restic
# This profile is tested with restic 0.19.1, installed after verifying its release checksum/signature.
# Encryption password is distinct from S3 credentials. Independently escrow it off the VPS.
RESTIC_PASSWORD_FILE=/PRIVATE_PATH/restic-password
AWS_ACCESS_KEY_ID=REPLACE_BUCKET_SCOPED_BACKUP_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_BUCKET_SCOPED_BACKUP_SECRET
AWS_DEFAULT_REGION=REPLACE_PROVIDER_REGION
NUMORA_OFFHOST_HOST_ALIAS=production-main
# PROPOSED example only. Review transfer time/resource budget; command bound is 15 minutes.
NUMORA_OFFHOST_LIMIT_KIB=2048
# Private/custom storage CA, when required. System CA verification remains enabled.
# RESTIC_CACERT=/PRIVATE_PATH/storage-ca.crt
