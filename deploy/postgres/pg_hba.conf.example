# Complete HBA for a NEW dedicated cluster; do not append behind permissive rules.
# Administrative Unix-socket access is only the local postgres OS account.
local   all                 postgres                                                   peer
local   all                 all                                                        reject
hostnossl all               all                    0.0.0.0/0                           reject
hostnossl all               all                    ::/0                                reject
hostssl numora_production   numora_api,numora_worker,numora_compute,numora_migrator     127.0.0.1/32 scram-sha-256
hostssl numora_production   numora_api,numora_worker,numora_compute,numora_migrator     ::1/128      scram-sha-256
host    all                 all                    0.0.0.0/0                           reject
host    all                 all                    ::/0                                reject
