# Server-only worker example; same target/prefix as API, separate non-owner Main runtime login.
NODE_ENV=production
NUMORA_DEPLOYMENT_PROFILE=production-vps
DATABASE_EXPECTED_HOST=db.numora.internal
DATABASE_EXPECTED_PORT=5432
DATABASE_EXPECTED_NAME=numora_production
DATABASE_EXPECTED_USER=numora_worker
DATABASE_URL=postgresql://numora_worker:REPLACE_URL_ENCODED_PASSWORD@db.numora.internal:5432/numora_production?sslmode=verify-full
DB_POOL_MAX=3
# NODE_EXTRA_CA_CERTS=/etc/numora/certs/postgres-ca.crt
REDIS_URL=rediss://default:REPLACE_URL_ENCODED_PASSWORD@REPLACE_REDIS_HOST:6379
BULLMQ_PREFIX=numora:prod:biznet
ALLOW_SYNTHETIC_CONTENT=false
PVP_MODE=disabled
PVP_CONTENT_MODE=strict
NUMORA_OBSERVABILITY_ENABLED=false
# Keep current IRT/generator/release feature states. These examples do not authorize enabling them.
# No DATABASE_MIGRATION_URL in the runtime process; separate migration credentials are provisioned later.
