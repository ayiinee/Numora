{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true
  },
  "watchOptions": {
    "watchFile": "dynamicPriorityPolling",
    "excludeDirectories": ["./dist", "./node_modules", "../../node_modules"],
    "excludeFiles": ["./node_modules/**", "../../node_modules/**"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
