# Copy to .env.test.local (ignored by Git). Never copy cloud development credentials.
# Start dedicated local PostgreSQL and Redis test services separately.
NODE_ENV=test
TEST_DATABASE_URL=postgres://postgres:test_only@localhost:5432/numora_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=numora:test:local
TEACHER_TOKEN_PEPPER=fixture-only-teacher-token-pepper-not-for-deployment
# Runtime URLs must not fall back to cloud services inherited from your shell.
DATABASE_URL=
REDIS_URL=
# Must exactly match TEST_DATABASE_URL; used only by db:migrate:test.
DATABASE_MIGRATION_URL=postgres://postgres:test_only@localhost:5432/numora_test?sslmode=disable

# JOB-10 foundation: explicit opt-in; never publishes student results.
IRT_V3_ENABLED=false
IRT_PSEUDONYM_KEY_VERSION=
