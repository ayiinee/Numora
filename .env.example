# Runtime
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
# Use the isolated cloud development branch/project, never real-user staging.
NEXT_PUBLIC_SUPABASE_URL=https://<development-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://<development-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Required server-only secret: generate at least 32 random bytes outside Git.
# Keep stable for outstanding short tokens (72h); never use NEXT_PUBLIC_.
TEACHER_TOKEN_PEPPER=

# Database: development branch runtime URL (direct or session pooler).
# Include ?sslmode=require (or ?sslmode=verify-full with the provider CA).
DATABASE_URL=
DB_POOL_MAX=3
# Supply only to the designated migration operator/runner; use a direct connection with sslmode.
DATABASE_MIGRATION_URL=

# Redis development: dedicated TCP/TLS instance, separate from test/staging.
# Prefixes isolate keys, NOT the provider's instance-wide request quota.
# pnpm dev starts web/API only; dev:worker or dev:full explicitly starts BullMQ.
REDIS_URL=
BULLMQ_PREFIX=numora:dev:<your-name>

# Server-only IRT respondent pseudonyms. Operator supplies a stable random key (at least 32 bytes).
# Leave empty while the Data model/worker integration is not enabled. Never use NEXT_PUBLIC_.
IRT_PSEUDONYM_KEY=

# PROPOSED support-event payloads: enable only after Data reviews docs/data/EVENTS.md.
SUPPORT_ANALYTICS_ENABLED=false

# PROPOSED domain payloads: Data approval required; server-only, never NEXT_PUBLIC.
DOMAIN_ANALYTICS_ENABLED=false

# Cloudflare R2 (not required for the Sprint-2 walking skeleton)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Observability (P1; optional during bootstrap)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
