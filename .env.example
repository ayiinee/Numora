# Runtime
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
# Server-only PvP activation. Initial staging may explicitly select demo.
# official requires approved non-DEMO packages. Never set a NEXT_PUBLIC equivalent.
PVP_MODE=disabled
# Temporary existing-content exception requires PVP_MODE=demo. See docs/development/PVP_TEMPORARY_READY_CONTENT.md.
PVP_CONTENT_MODE=strict
# Emergency stop for new rooms; keep the selected policy for current-match recovery.
PVP_NEW_MATCHES_ENABLED=true

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
# Use the isolated cloud development branch/project, never real-user staging.
NEXT_PUBLIC_SUPABASE_URL=https://<development-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://<development-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Optional Development QA provisioning only (see docs/testing/QA_SEED.md).
# qa:accounts requires the exact approved sandbox and a server-only sb_secret_* key.
SUPABASE_PROJECT_REF=
SUPABASE_SECRET_KEY=
# Required server-only secret: generate at least 32 random bytes outside Git.
# Keep stable for outstanding short tokens (72h); never use NEXT_PUBLIC_.
TEACHER_TOKEN_PEPPER=

# Database: development branch runtime URL (direct or session pooler).
# Include ?sslmode=require (or ?sslmode=verify-full with the provider CA).
DATABASE_URL=
DB_POOL_MAX=3
# Supply only to the designated migration operator/runner; use a direct connection with sslmode.
DATABASE_MIGRATION_URL=

# Redis development: dedicated TCP/TLS instance, separate from test/staging.
# Prefixes isolate keys, NOT the provider's instance-wide request quota.
# pnpm dev starts web/API only; dev:worker or dev:full explicitly starts BullMQ.
REDIS_URL=
BULLMQ_PREFIX=numora:dev:<your-name>

# Server-only IRT respondent pseudonyms. Operator supplies a stable random key (at least 32 bytes).
# Leave empty while the Data model/worker integration is not enabled. Never use NEXT_PUBLIC_.
IRT_PSEUDONYM_KEY=

# PROPOSED support-event payloads: enable only after Data reviews docs/data/EVENTS.md.
SUPPORT_ANALYTICS_ENABLED=false

# PROPOSED domain payloads: Data approval required; server-only, never NEXT_PUBLIC.
DOMAIN_ANALYTICS_ENABLED=false

# Cloudflare R2 (not required for the Sprint-2 walking skeleton)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: bucket/prefix-scoped temporary S3 credentials.
R2_SESSION_TOKEN=
R2_BUCKET=numora-bucket
R2_PUBLIC_BASE_URL=
# Private media upload endpoints remain disabled until the server credentials are set.
R2_MEDIA_UPLOADS_ENABLED=false
R2_MEDIA_PREFIX=question-media
R2_UPLOAD_TTL_SECONDS=900

# Observability (P1; optional during bootstrap)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# JOB-10 foundation: explicit opt-in; never publishes student results.
IRT_V3_ENABLED=false
IRT_PSEUDONYM_KEY_VERSION=

# Internal DRAFT importer/preview; requires explicit Content Admin assignment.
CONTENT_IMPORT_PREVIEW_ENABLED=false

# Server-only opt-in for the named Development project or isolated numora_test database.
ALLOW_SYNTHETIC_CONTENT=false

# Generator v1 � server only, disabled until mapping/approval and local QA pass.
NUMORA_GENERATOR_ENABLED=false
NUMORA_GENERATOR_URL=http://127.0.0.1:8770
NUMORA_GENERATOR_TOKEN=
